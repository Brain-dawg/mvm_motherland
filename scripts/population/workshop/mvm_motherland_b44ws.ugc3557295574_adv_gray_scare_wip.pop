    Mission
    {
        Objective Sniper

        InitialCooldown 0
        Where spawnbot_base_upper3
        Where spawnbot_pointA_upper3
        Where spawnbot_pointB_flank3
        BeginAtWave 3
        RunForThisManyWaves 1
        CooldownTime 25
        DesiredCount 2

        TFBot
        {
            Class Sniper
            Skill Hard
            Name Sniper
            MaxVisionRange 4000

            Item "The Hitman's Heatmaker"
            Item "Letch's LED"

            Tag bot_mission
        }
    }

    Mission
    {
        Objective Sniper

        InitialCooldown 10
        Where spawnbot_base_battlements3
        Where spawnbot_pointA_flank3
        Where spawnbot_pointB_flank3
        BeginAtWave 3
        RunForThisManyWaves 1
        CooldownTime 25
        DesiredCount 1

        TFBot
        {
