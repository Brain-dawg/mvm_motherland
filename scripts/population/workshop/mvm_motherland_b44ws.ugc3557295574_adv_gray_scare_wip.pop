#base robot_giant.pop
#base robot_standard.pop
#base robot_gatebot.pop

WaveSchedule
{
    StartingCurrency 1400
    RespawnWaveTime  6
    CanBotsAttackWhileInSpawnRoom No
    Advanced 1

    Templates
    {
        Motherland_Train
        {
            Name "Carrier Train"
            Class Engineer
            Health 15000
            ClassIcon crossguard_lite
            Attributes IgnoreFlag
            Attributes IgnoreEnemies
            Attributes UseBossHealthBar
            Attributes MiniBoss
            MaxVisionRange 1
            Tag bot_motherland_train

            CharacterAttributes
            {
                "move speed penalty" 0.0001
                "no_jump" 1
                "no_duck" 1
                "cancel falling damage" 1
            }
        }

        Motherland_Scout_Whimp
        {
            Class Scout
            Skill Easy

            ItemAttributes
            {
                ItemName "TF_WEAPON_SCATTERGUN"
                "damage penalty" 0.75
            }
        }

        Motherland_Demo_Targe_Armored
        {
            Class Demoman
            Name "Mildly Large Hybridknight"
            ClassIcon demo_with_targe_armored

            Item "Blast Defense"

            Skill Normal
            Health 650
            WeaponRestrictions PrimaryOnly
            Item "The Chargin' Targe"
            Scale 1.4
        }

        Motherland_Heavy_Shotgun_Armored
        {
            Class Heavyweapons
