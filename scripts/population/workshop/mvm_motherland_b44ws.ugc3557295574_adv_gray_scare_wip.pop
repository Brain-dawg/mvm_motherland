    Wave //Wave 1
    {
        WaitWhenDone 65
        Checkpoint Yes

        InitWaveOutput
        {
            Target logic_script_motherland
            Action RunScriptCode
            Param "
                SetPropString(tf_objective_resource, `m_iszMvMPopfileName`, `(ADV) Gray Scare (WIP)`)
                PutPointBUnderSiege(true)
            "
        }

        WaveSpawn
        {
            TotalCurrency 20

            TotalCount 8
            MaxActive  8
            SpawnCount 4

            WaitBetweenSpawns 3

