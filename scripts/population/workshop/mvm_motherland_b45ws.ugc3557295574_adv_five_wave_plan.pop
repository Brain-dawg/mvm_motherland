            Skill Hard

            Tag bot_mission
        }
    }

    Mission
    {
        Objective DestroySentries

        Where spawnbot_base_upper
        Where spawnbot_pointA_battlements
        Where spawnbot_pointB_flank

        CooldownTime 30

        TFBot
        {
            Template T_TFBot_SentryBuster

            Tag bot_sentrybuster
            Tag mission_sentry_buster
            Tag bot_mission
        }
    }

