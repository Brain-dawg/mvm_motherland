            Where spawnbot_pointA_jetpack2
            Where spawnbot_pointB_main

            FirstSpawnOutput
            {
                Target logic_script_motherland
                Action RunScriptCode
                Param "
                    if (IsPointAUnderSiege())
                        return

                    RunWithDelay(0.1, function()
                    {
                        foreach (bot in GetAlivePlayers(TF_TEAM_PVE_INVADERS))
                        {
                            if (bot.HasBotTag(`bot_boss`))
                            {
                                local multiplier = IsPointBUnderSiege() ? 0.694 : 0.494
                                bot.AddCustomAttribute(`hidden maxhealth non buffed`, bot.GetMaxHealth() * multiplier, -1)
                                bot.SetMaxHealth(bot.GetMaxHealth() * multiplier)
                                bot.SetHealth(bot.GetMaxHealth())
                                break
                            }
                        }
                    })
                "
            }

            TFBot
            {
                Template Motherland_Chief_Heavy_Soviet_Bear
            }
        }
