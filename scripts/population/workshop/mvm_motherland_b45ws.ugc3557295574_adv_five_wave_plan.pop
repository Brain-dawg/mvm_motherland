            WaitForAllSpawned "W1S3_ArmoredHeavies"

            Where spawnbot_base_main
            Where spawnbot_pointA_main
            Where spawnbot_pointB_main

            FirstSpawnOutput
            {
                Target logic_script_motherland
                Action RunScriptCode
                Param "
                    OnNextTick(function()
                    {
                        foreach (bot in GetAlivePlayers(TF_TEAM_PVE_INVADERS))
                        {
                            if (bot.HasBotTag(`jetpack_hack`))
                            {
                                local jetpackSpawn = FindByName(null, `spawnbot_base_jetpack1`)
                                bot.Teleport(true, jetpackSpawn.GetOrigin(), true, jetpackSpawn.GetAbsAngles(), true, Vector())
                                break
                            }
                        }
                    })
                "
            }

            Squad
            {
                ShouldPreserveSquad 1

                TFBot
                {
                    Template T_TFBot_Giant_Soldier

                    Tag jetpack_hack
                    Tag nav_main
                }
                TFBot { Template T_TFBot_Medic_BigHeal }
                TFBot { Template T_TFBot_Medic_BigHeal }
                TFBot { Template T_TFBot_Medic_BigHeal }
                TFBot { Template T_TFBot_Medic_BigHeal }
            }
        }
