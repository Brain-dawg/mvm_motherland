            Where spawnbot_base_closet
            Where spawnbot_pointA_main
            Where spawnbot_pointB_main

            FirstSpawnOutput
            {
                Target logic_script_motherland
                Action RunScriptCode
                Param "
                    OnNextTick(function()
                    {
                        foreach (bot in GetAlivePlayers(TF_TEAM_PVE_INVADERS))
                        {
                            if (bot.HasBotTag(`jetpack_hack`))
                            {
                                local jetpackSpawn = FindByName(null, `spawnbot_base_jetpack2`)
                                bot.Teleport(true, jetpackSpawn.GetOrigin(), true, jetpackSpawn.GetAbsAngles(), true, Vector())
                                break
                            }
                        }
                    })

                    RunWithDelay(10, function()
                    {
                        foreach (bot in GetAlivePlayers(TF_TEAM_PVE_INVADERS))
                        {
                            if (bot.HasBotTag(`taunt_on_leave`))
                            {
                                SetPropFloat(bot, `m_Shared.m_flRageMeter`, 100)
                                bot.Taunt(TAUNT_BASE_WEAPON, 0)
                                break
                            }
                        }
                    })
                "
            }

            Squad
            {
                TFBot
                {
                    Template Motherland_Pyro_Phlog_Giant
                    Tag taunt_on_leave
                    Tag bot_no_radio_jump
                }
                TFBot { Template T_TFBot_Giant_Medic_Regen Tag jetpack_hack }
            }
        }

