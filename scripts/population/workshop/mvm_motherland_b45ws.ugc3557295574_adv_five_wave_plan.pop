#base robot_standard.pop
#base robot_giant.pop
#base robot_gatebot.pop

WaveSchedule
{
    StartingCurrency 1200
    RespawnWaveTime  6
    CanBotsAttackWhileInSpawnRoom No
    Advanced 1

    Templates
    {
        Motherland_Train
        {
            Name "Carrier Train"
            Class Engineer
            Health 15000
            ClassIcon crossguard_lite
            Attributes IgnoreFlag
            Attributes IgnoreEnemies
            Attributes UseBossHealthBar
            Attributes MiniBoss
            MaxVisionRange 1
            Tag bot_motherland_train

            CharacterAttributes
            {
                "move speed penalty" 0.0001
                "no_jump" 1
                "no_duck" 1
                "cancel falling damage" 1
            }
        }

        Motherland_Heavy_Shotgun_Armored
        {
            Class Heavyweapons
            Name "Mildly Large Shotgun Heavy"
            ClassIcon heavy_shotgun_armored

            Item "Road Rage"

            Skill Normal
            Health 800
            WeaponRestrictions SecondaryOnly
            MaxVisionRange 1200
            Scale 1.4
        }

        Motherland_Pyro_Phlog
        {
            Name "Phlog Pyro"
            Class Pyro
            Skill Normal
            WeaponRestrictions PrimaryOnly
            Item "The Phlogistinator"
            Tag bot_phlog_pyro
            ClassIcon pyro_phlog_lite
        }

        Motherland_Pyro_Phlog_Giant
        {
            Name "Giant Phlog Pyro"
            Template T_TFBot_Giant_Pyro
            Item "The Phlogistinator"
            Attributes AlwaysFireWeapon
            Tag bot_phlog_pyro
            ClassIcon pyro_phlog_lite_giant
            Skill Hard

            CharacterAttributes
            {
                "gesture speed increase" 0.75
            }
        }

        Motherland_Medic_Kritz
        {
            Class Medic
            Name "Krit Medic"
            ClassIcon medic_kritz_lite
            Skill Expert
            Item "The Kritzkrieg"
            Attributes SpawnWithFullCharge

            ItemAttributes
            {
                ItemName "The Kritzkrieg"
                "ubercharge rate bonus" 100
                "uber duration bonus" 9999
            }

            CharacterAttributes
            {
                "bot medic uber health threshold" 999
            }
        }

        Motherland_Heavy_LaserEyes
        {
            Class Heavyweapons
            Name "Giant Laser Eyes Heavy"
            ClassIcon boss_spawner
            Skill Expert
            Health 9001
            Scale 2.3
            Item "The U-clank-a"
            Item "TF_WEAPON_FISTS"

            WeaponRestrictions MeleeOnly
            Attributes MiniBoss

            Tag bot_lasereyes
            Tag bot_no_radio_jump

            ItemAttributes
            {
                ItemName "TF_WEAPON_FISTS"
                "no_attack" 1
            }

            CharacterAttributes
            {
                "move speed bonus"	0.3
                "damage force reduction" 0.3
                "airblast vulnerability multiplier" 0.3
                "override footstep sound set" 2
            }
        }

        Motherland_Chief_Heavy_Soviet_Bear
        {
            Class Heavyweapons
            Name "Советский Медведь"
            ClassIcon heavy_soviet_bear
            Health 50000
            Scale 2.49

            Skill Hard
            MaxVisionRange 1600

            Item "The U-clank-a"
            Item "Iron Curtain"
            Item "Cossack Camo"

            Attributes UseBossHealthBar
            Attributes MiniBoss
            WeaponRestrictions PrimaryOnly

            Tag bot_lasereyes
            Tag bot_boss
            Tag nav_flank
            Tag bot_very_big

            ItemAttributes
            {
                ItemName "TF_WEAPON_MINIGUN"
                "damage bonus" 2.0
                "dmg bonus vs buildings" 3.0
            }

            CharacterAttributes
            {
                "move speed bonus"	0.5
                "damage force reduction" 0.3
                "airblast vulnerability multiplier" 0.4
                "airblast vertical vulnerability multiplier" 0.1
                "rage giving scale"	0.9
                "override footstep sound set" 2
            }
        }

        Motherland_Scout_Bonk_Or_Scattergun
        {
            Class Scout
            ClassIcon scout_bonk

            EventChangeAttributes
            {
                Default
                {
                    Skill Hard
                    Item "Bonk! Atomic Punch"
                    Item "Bonk Helm"
                    WeaponRestrictions MeleeOnly
                }
                PointACaptured
                {
                    Skill Normal
                }
                PointBCaptured
                {
                    Skill Normal
                }
            }
        }

        Motherland_Soldier_DirectHit
        {
            Class Soldier
            Item "The Direct Hit"
            Skill Normal
            ClassIcon soldier_directhit_lite
        }
    }

    Mission
    {
        Objective Sniper

        InitialCooldown 15
        Where spawnbot_base_upper2
        Where spawnbot_pointA_upper2
        Where spawnbot_pointB_flank2
        BeginAtWave 2
        RunForThisManyWaves 1
        CooldownTime 25
        DesiredCount 1

        TFBot
        {
            Class Sniper
            Skill Normal
            MaxVisionRange 4000

            Item "The Cold Killer"
            Item "Sydney Shearling"

            Tag bot_mission
