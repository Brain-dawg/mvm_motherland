#base robot_standard.pop
#base robot_giant.pop
#base robot_gatebot.pop

WaveSchedule
{
    StartingCurrency 600
    RespawnWaveTime  5
    CanBotsAttackWhileInSpawnRoom No
    Advanced 0

    Templates
    {
        Motherland_Train
        {
            Name "Carrier Train"
            Class Engineer
            Health 15000
            ClassIcon crossguard_lite
            Attributes IgnoreFlag
            Attributes IgnoreEnemies
            Attributes UseBossHealthBar
            Attributes MiniBoss
            MaxVisionRange 1
            Tag bot_motherland_train

            CharacterAttributes
            {
                "move speed penalty" 0.0001
                "no_jump" 1
                "no_duck" 1
                "cancel falling damage" 1
            }
        }

        Motherland_Heavy_Shotgun_Armored
        {
            Class Heavyweapons
            Name "Mildly Large Shotgun Heavy"
            ClassIcon heavy_shotgun_armored

            Item "Road Rage"

            Skill Normal
            Health 800
            WeaponRestrictions SecondaryOnly
            MaxVisionRange 1200
            Scale 1.4
        }

        Motherland_Pyro_NoAirblast
        {
            Class Pyro
            Skill Normal
            WeaponRestrictions PrimaryOnly
            Item "The Nostromo Napalmer"

            ItemAttributes
            {
                ItemName "The Nostromo Napalmer"
                "airblast disabled" 1
            }
        }

        Motherland_Pyro_Phlog_Giant
        {
            Name "Giant Phlog Pyro"
            Template T_TFBot_Giant_Pyro
            Item "The Phlogistinator"
            Attributes AlwaysFireWeapon
            Tag bot_phlog_pyro
            ClassIcon pyro_phlog_lite_giant
            Skill Hard

            CharacterAttributes
            {
                "gesture speed increase" 0.75
            }
        }
    }

    Mission
    {
        Objective Spy

        InitialCooldown 25
        Where spawnbot_pointA_main2
        Where spawnbot_pointB_main2
        BeginAtWave 5
        RunForThisManyWaves 1
        CooldownTime 40
        DesiredCount 3

        TFBot
        {
            Class Spy
            Skill Hard

            Tag bot_mission
        }
    }

    Mission
    {
        Objective DestroySentries

        Where spawnbot_base_upper
        Where spawnbot_pointA_battlements
        Where spawnbot_pointB_flank

        CooldownTime 30

        TFBot
        {
            Template T_TFBot_SentryBuster

            Tag bot_sentrybuster
            Tag mission_sentry_buster
            Tag bot_mission
        }
    }

    Wave //Wave 1
    {
        WaitWhenDone 65
        Checkpoint Yes

        InitWaveOutput
        {
            Target logic_script_motherland
            Action RunScriptCode
            Param "
                SetPropString(tf_objective_resource, `m_iszMvMPopfileName`, `(Int) Russian Riot`)
                PutHatchUnderSiege(true)
            "
        }

        WaveSpawn
        {
            TotalCurrency 200

            TotalCount 30
            MaxActive  4
            SpawnCount 2

            WaitBetweenSpawns 6

            Where spawnbot_pointB_main

            TFBot
            {
                Template T_TFBot_Heavyweapons_Heavyweight_Champ_Fast
            }
        }

        WaveSpawn
        {
            TotalCurrency 200

