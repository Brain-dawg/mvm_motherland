    Wave //Wave 3
    {
        WaitWhenDone 65
        Checkpoint Yes

        InitWaveOutput
        {
            Target logic_script_motherland
            Action RunScriptCode
            Param "
                SetPropString(tf_objective_resource, `m_iszMvMPopfileName`, `(Int) Russian Riot`)
                PutHatchUnderSiege()

                SendGlobalGameEvent(`show_annotation`, {
                    worldposX = -3820
                    worldposY = -415
                    worldposZ = 130
                    id = POINT_ANNOTATION_MAGIC_ID
                    text = `Bots will invade from the yard!`
                    lifetime = -1
                    play_sound = `misc/null.wav`
                })

                EntFire(`hologram*`, `Kill`, ``, 0.2)

                ConvertFromGateBotOriginal <- ConvertFromGateBot
                ConvertFromGateBot = function(bot) { }

                RecalculateSpawnsOriginal <- RecalculateSpawns
                RecalculateSpawns = function()
                {
                    RecalculateSpawnsOriginal()
                    EntFire(POINTB_DOOR_ENTNAME, `Close`)
                }
                RecalculateSpawns()

                ConvertToJetpackRobotOriginal <- ConvertToJetpackRobot
                ConvertToJetpackRobot = function(bot, teleportDestinationName)
                {
                    ConvertToJetpackRobotOriginal(bot, teleportDestinationName)
                    bot.Teleport(true, Vector(-4000, -576, 1692), true, QAngle(0, 270, 00), true, Vector())
                }
            "
        }

        WaveSpawn
        {
            Name "W3_Train"
            TotalCurrency 300

            TotalCount 1
            MaxActive  1
            SpawnCount 1

            Where spawnbot_base_main
            Where spawnbot_pointA_main
            Where spawnbot_pointB_main

            DoneOutput
            {
                Target logic_script_motherland
                Action RunScriptCode
                Param "
                    RecalculateSpawns = RecalculateSpawnsOriginal
                    delete RecalculateSpawnsOriginal

                    ConvertToJetpackRobot = ConvertToJetpackRobotOriginal
                    delete ConvertToJetpackRobotOriginal

                    ConvertFromGateBot = ConvertFromGateBotOriginal
                    delete ConvertFromGateBotOriginal
                "
            }

            TFBot
            {
                Template Motherland_Train
            }
        }

        WaveSpawn
        {
            TotalCurrency 100

            Support 1

            TotalCount 1
            MaxActive  1
            SpawnCount 1

            WaitBeforeStarting 37
            WaitBetweenSpawnsAfterDeath 50

            Where spawnbot_pointB_jetpack2

            TFBot
