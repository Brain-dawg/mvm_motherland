    //WAVE 1 ///////////////////////////////////////////////////////////////////////////////////////////////////////

    Wave
    {
        InitWaveOutput
        {
            Target logic_script_motherland
            Action RunScriptCode
            Param "
                SetPropString(tf_objective_resource, `m_iszMvMPopfileName`, `(ADV) Tundra Flux`)
